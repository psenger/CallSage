            "name": "",
            "code": "// Original JSON data\r\nconst data = viewing_buttons;\r\n\r\n// Extract \"Property Name\" and create a new array\r\npropertyNamesArray = data.map(item => ({\r\n  \"Property Name\": item.fields[\"Property Name\"]\r\n}));",
            "paths": [],
            "portsV2": {
