        "678f63abeb1cee0eacde424c": {
          "type": "code",
          "data": {
            "name": "",
            "code": "const jsonData = new_listings;\noutputArray = jsonData.map((item, index, array) => {\n    const fields = item.fields;\n    return {\n        id: item.id,\n        createdTime: item.createdTime,\n        ...fields,\n        __IMTINDEX__: index + 1,\n        __IMTLENGTH__: array.length\n    };\n});",
