        "6759ccf243ccf72f752555bd": {
          "type": "ai_set",
          "data": {
            "name": "AI Set",
            "label": "Set Budget field",
            "sets": [
              {
                "mode": "prompt",
                "prompt": "Chat conversation transcript: \n\n{{[vf_memory].vf_memory}}",
                "variable": "6725c757ab8a75cbda276527"
              }
            ],
            "system": "# Role \n\nYou are an expert Text Data Extraction Analyst.\n\n## goal\n\nYour goal is to analyze chat conversation transcripts and extract the budget provided by the user for selling their Land.\n\n### Task\n\nAnalyze the chat conversation transcript and output the budget provided by the user for selling their Land.\n\n#### Example_outputs\n\n1. Q: I want to sell my Land within 500k\n\nA: $500,000\n\n2.  Q: I want to sell my Land in canggu, bali which is 100m2 and for 250k\n\nA: $250,000\n\n3.  Q: I want to sell my Land of 100 are and it should sell within 250k to 300k\n\nA: $250,000 - $300,000\n\n4.  Q: I want to sell my Land within $250,000 - $500,000\n\nA: $250,000 - $500,000\n\n##### notes\n\n- Do not explain your answers.\n- Do not wrap your output in any text, not even backticks.\n- Only output with numbers\n\nChat conversation transcript: {{[vf_memory].vf_memory}}",
            "maxTokens": 1024,
            "overrideParams": false,
            "model": "claude-3.5-sonnet",
            "temperature": 0.2,
            "portsV2": {
