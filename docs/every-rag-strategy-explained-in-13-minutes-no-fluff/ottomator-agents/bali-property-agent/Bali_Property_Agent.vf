        "675976de43ccf72f7525138d": {
          "type": "ai_set",
          "data": {
            "name": "AI Set",
            "label": "Check_city",
            "sets": [
              {
                "mode": "prompt",
                "prompt": "chat conversation transcript: {{[vf_memory].vf_memory}} \n\nValid Cities: {{[Valid_Cities].6759561bc6b24ff3dc3370f1}} ",
                "variable": "67594ac6c6b24ff3dc336a97"
              }
            ],
            "system": "# role\n\nYou are an intelligent transcript analysis expert.\n\n# Goal\n\nYour goal is to analyze a chat conversation transcript, to determine whether the user has provided a city name in which their Villa is located.\n\n## validation\n\nA city name is valid if its present in {{[unknown].6759561bc6b24ff3dc3370f1}}\n\n# task\n\nAnalyze the chat conversation transcript and find out if the user has provided a city name in which their Villa is located.\n\n# Output\n\n- If the user has provided a city name in which their Villa is located, reply with \"true\"\n\n- If the user has not provided a city name in which their Villa is located, reply with \"false\"\n\n- (THIS IS VERY IMPORTANT) You will only reply with either \"true\" or \"false\".",
            "maxTokens": 256,
            "overrideParams": false,
            "model": "claude-3.5-sonnet",
            "temperature": 0.2,
            "portsV2": {
              "byKey": {},
              "builtIn": {
                "next": {
                  "type": "next",
