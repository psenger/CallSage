          ]
        },
        "678390ffd6bbd83c54087381": {
          "type": "code",
          "data": {
            "name": "",
            "code": "// cardFormatter function definition\r\nfunction cardFormatter({\r\n    id,\r\n    index,\r\n    title,\r\n    desc,\r\n    imgURL,\r\n    buttons,\r\n}) {\r\n    return {\r\n        \"id\": id,\r\n        \"title\": title || '',\r\n        \"description\": {\r\n            \"slate\": [\r\n                {\r\n                    \"children\": [\r\n                        {\r\n                            \"text\": desc || ''\r\n                        }\r\n                    ]\r\n                }\r\n            ],\r\n            \"text\": desc || ''\r\n        },\r\n        \"imageUrl\": imgURL,\r\n        \"buttons\": buttons.map((item, btnIndex) => {\r\n            const label = (item.includes(\":\") ? item.split(`:`)[0] : item).replace(/_/g, ' ') || '';\r\n            const buttonURL = item.includes(`:`) ? item.split(`:`)[1] : false;\r\n\r\n            return {\r\n                \"name\": label,\r\n                \"request\": {\r\n                    \"type\": `dcarousel_selection`,\r\n                    \"payload\": {\r\n                        \"id\": id,\r\n                        \"card_index\": index,\r\n                        \"button_index\": btnIndex,\r\n                        \"label\": label,\r\n                        \"actions\": buttonURL ? [\r\n                            {\r\n                                \"type\": \"open_url\",\r\n                                \"payload\": {\r\n                                    \"url\": buttonURL\r\n                                }\r\n                            }\r\n                        ] : []\r\n                    }\r\n                }\r\n            }\r\n        })\r\n    };\r\n}\r\n\r\n// Airtable API response\r\nconst airtableResponse = recieivingATresponse;\r\n\r\n// Raw carousel object\r\nconst rawCarousel = {\r\n    \"layout\": \"Carousel\",\r\n    \"cards\": []\r\n};\r\n\r\n// Process the Airtable API response and dynamically populate rawCarousel.cards\r\nairtableResponse.forEach((property, index) => {\r\n    rawCarousel.cards.push(\r\n        cardFormatter({\r\n            id: property.id,\r\n            index: index, // Current card index\r\n            title: property[\"Property Name\"],\r\n            desc: `${property.Type} || $${property.Price.toFixed(2)}`,\r\n            imgURL: property[\"Property Images\"],\r\n            buttons: [\r\n                `Schedule a Viewing:`,\r\n                `Browse nearby amenities:`,\r\n                `View Listing:${property.Link}`\r\n            ]\r\n        })\r\n    );\r\n});\r\n\r\n// Add extra logic for button adjustments\r\nrawCarousel.cards.forEach((card, cardIndex) => {\r\n    card.buttons[0].request.payload.value = card.title;\r\n    card.buttons[1].request.payload.value = card.title;\r\n    card.buttons[2].request.payload.value = card.title;\r\n});\r\n\r\n// Final formatted carousel JSON\r\nVG_DCarousel_Formatted = JSON.stringify(rawCarousel);\r\nnumber_of_carousels = recieivingATresponse.length;",
            "paths": [],
            "portsV2": {
              "byKey": {},
              "builtIn": {
