  "entityVariants": [],
  "intents": [
    {
      "id": "67405e895401f5ab8479cc0d",
      "name": "See_properties_available",
      "createdByID": 1481114,
      "folderID": null,
      "description": "Trigger this intent only when user explicitly states that they want to see properties in Bali which are available in our Portfolio. \n\nDo not assume the needs of the user, beyond what is explicitly stated in the conversation.\n\nOnly trigger this intent if the user clearly indicate that they want to see properties which are available in our portfolio in Bali.  ",
      "automaticReprompt": true,
      "entityOrder": [
        "678f55a95c1ed4a72366c8dd"
      ],
      "automaticRepromptSettings": {
        "params": null
      },
      "createdAt": "2025-01-22T06:09:15.000Z",
      "updatedAt": "2025-01-22T06:09:15.000Z",
      "updatedByID": 1481114
    },
    {
      "id": "672721979ba11d6e98fa41f5",
      "name": "Talk to a human",
      "createdByID": 1481114,
      "folderID": null,
      "description": "Trigger this intent when the user wants to speak with a human agent. Only trigger this intent, when the user message shows that the user wants to explicitly speak with a human.\n\nDo not assume the needs of the user at any point, only trigger this intent when the user message clearly indicates that they want to speak with a human.\n\nDO NOT trigger this intent when a user asks for a variation of the message \"what do you do.\" \n\nalso DO NOT Trigger this intent when a user answers a question with any variations of a \"yes\" or a \"no\".",
      "automaticReprompt": false,
      "entityOrder": [],
      "automaticRepromptSettings": null,
      "createdAt": "2025-01-22T06:09:15.000Z",
      "updatedAt": "2025-01-22T06:09:15.000Z",
      "updatedByID": 1481114
    },
    {
      "id": "None",
      "name": "None",
      "createdByID": 1481114,
      "folderID": null,
      "description": null,
      "automaticReprompt": false,
      "entityOrder": [],
      "automaticRepromptSettings": null,
