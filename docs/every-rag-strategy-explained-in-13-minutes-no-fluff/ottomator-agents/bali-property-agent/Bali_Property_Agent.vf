        "676031785691bbb19444125f": {
          "type": "code",
          "data": {
            "name": "",
            "code": "const allOptions = uniqueArray;\r\n\r\n// User-selected options (from the previous block, stored in the variable \"last_utterance\")\r\nconst selectedOptions = SelectedAmenity; // Access Voiceflow variable\r\n\r\n// Ensure \"last_utterance\" is parsed as an array, if necessary\r\nconst userSelectedArray = Array.isArray(selectedOptions) ? selectedOptions : JSON.parse(selectedOptions);\r\n\r\n// Filter out the selected options to get the remaining options\r\nconst remainingOptions = allOptions.filter(option => !userSelectedArray.includes(option));\r\n\r\nconst rawButtons = {\r\n  \"buttons\": [] // This will hold the dynamically generated buttons\r\n};\r\n\r\n/**\r\n * Button formatter function\r\n * Takes id, label, and index to format buttons for Voiceflow\r\n */\r\nfunction btnFormatter({ id, label, index }) {\r\n  return {\r\n    \"name\": label,\r\n    \"request\": {\r\n      \"type\": \"next\",\r\n      \"payload\": {\r\n        \"btn_index\": index,\r\n        \"btn_id\": id,\r\n        \"label\": label,\r\n        \"actions\": []\r\n      }\r\n    }\r\n  };\r\n}\r\n\r\n// Generate buttons for the remaining options\r\nremainingOptions.forEach((option, index) => {\r\n  rawButtons.buttons.push(\r\n    btnFormatter({\r\n      id: `btn_${index}`, // Unique ID for each button\r\n      index: index, // Button index\r\n      label: option // Button label\r\n    })\r\n  );\r\n});\r\n\r\n/**\r\n * Save the generated buttons into a Voiceflow variable\r\n */\r\ndynamicAmenitiesButtons = JSON.stringify(rawButtons);",
            "paths": [],
            "portsV2": {
              "byKey": {},
              "builtIn": {
                "next": {
                  "type": "next",
                  "target": null,
                  "id": "676031785691bbb194441261",
