      "updatedByID": 1481114
    },
    {
      "id": "672b3ccd536596588802d7b3",
      "name": "Buy a villa",
      "createdByID": 1481114,
      "folderID": null,
      "description": "Trigger this intent when the user explicitly  states that they want to buy a Villa. \n\nAnalyze the {vf_memory} to understand if the user wants to buy a villa or not.\n\nOnly trigger this intent if the user wants to buy a villa. \n\nDo not trigger this intent, if a user expresses interest in \"buying a property\", remember that is still a vague response and user might be interested in buying some other kind of property.\n\nDo not assume the needs of the user, unless it is explicitly stated by them.\n\nRemember the difference between \"asking a question\" and \"stating an intent\". If a user asks any variations of questions like \"how much does the villa in canggu cost\" remember that is a question, and that is not an intent to buy the villa.\n\nDO NOT trigger this intent, if the user is mentioning a measurement or area size, examples of a measurement and area size are: any variations of - \"100m2\", \"100 m square\", \" 2 acres\", \"2 areas\", \"2 kattah\".\n\nOnly trigger the intent when the user WANTS to buy a villa. ",
      "automaticReprompt": false,
      "entityOrder": [],
      "automaticRepromptSettings": null,
      "createdAt": "2025-01-22T06:09:15.000Z",
