        "678b4b4759dd64afa561bd4f": {
          "type": "ai_set",
          "data": {
            "name": "AI Set",
            "label": "Check_kind",
            "sets": [
              {
                "mode": "prompt",
                "prompt": "chat conversation transcript: {{[vf_memory].vf_memory}} \n\nValid Kinds: {{[unknown].678b49f9e1d80c201d9aef75}}",
                "variable": "678b4b95e1d80c201d9aeffc"
              }
            ],
            "system": "# role\n\nYou are an intelligent transcript analysis expert.\n\n# Goal\n\nYour goal is to analyze a chat conversation transcript, to determine whether the user has mentioned the kind of Villa they own.\n\n## validation\n\nThe valid kind of villas only include any of the following: {{[unknown].678b49f9e1d80c201d9aef75}}\n\n# task\n\nAnalyze the chat conversation transcript and find out if the user has mentioned the kind of Villa they own.\n\n# Output\n\n- If the user has mentioned a Valid kind of villa they own, reply with \"true\".\n\n- If the user has not mentioned a Valid kind of villa they own, reply with \"false\".\n\n- (THIS IS VERY IMPORTANT) You will only reply with either \"true\" or \"false\".\n\n# examples\n\n1.\nQ:  Conversation history: assistant: Let me collect some information first, this way I can help you with listing and sale of you villa.In which city/area is your villa located ?user: i wanna sell my beachfront villa for investmentassistant: Let me collect some information first, this way I can help you with listing and sale of you villa.In which city/area is your villa located?user: Uluwatu\n\nA: true\n\n2. \nQ:  Conversation history: assistant: Let me collect some information first, this way I can help you with listing and sale of you villa.In which city/area is your villa located ?user: i wanna sell the my new villa for investmentassistant: Let me collect some information first, this way I can help you with listing and sale of you villa.In which city/area is your villa located?user: Pererenan\n\nA: false",
            "maxTokens": 128,
            "overrideParams": false,
            "model": "claude-3.5-sonnet",
            "temperature": 0.2,
            "portsV2": {
              "byKey": {},
              "builtIn": {
