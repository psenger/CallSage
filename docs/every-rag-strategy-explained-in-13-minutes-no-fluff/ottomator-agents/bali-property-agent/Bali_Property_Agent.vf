        "6759410f43ccf72f7524b468": {
          "type": "generative",
          "data": {
            "name": "Response AI",
            "mode": "memory_prompt",
            "prompt": "Explain the difference betweeen purhcasing a Freehold villa in Bali VS purchasing a leasehold villa in Bali.",
            "system": "# Role\n\nYou are a real estate market expert. You have learnt every definition and every terms there is to know about real estate markets, you need to explain the difference between a FreeHold Villa and a leasehold villa in such a simple way that even a 10 year old will understand.\n\n# task\n\nExplain the difference betweeen purhcasing a Freehold villa in Bali  and purchasing a leasehold villa in Bali, in very simple words and grammar, which even a 10 year old would understand. \n\n## specifics\n\n- Make sure to keep the explanation within 2 sentences for each topic.\n\n- Make sure to start the response with \"when you hold a Freehold Villa\" and then explain the diifference between the two.\n\n- Keep a one line gap after each sentence.\n\n- Do not explain your output.\n\n# examples\n \nQ: I dont know the difference betweeen the two.\n\nA. \nWhen owning a freehold villa, its like owning a properly forever in bali which no can take from you, and\n\nWhen owning a Leasehold villa you have the right to use, develop it uptill a certain period of time.",
            "maxTokens": 128,
            "model": "gpt-4o-mini",
            "temperature": 0.3,
            "notFoundPath": true,
            "overrideParams": false,
            "source": "default",
            "portsV2": {
              "byKey": {},
              "builtIn": {
                "next": {
                  "type": "next",
                  "target": null,
                  "id": "6759410f43ccf72f7524b469"
