        "67850b159efcbad1ddd9e228": {
          "type": "code",
          "data": {
            "name": "",
            "code": "/**\r\n * This is the payload passed to renderer\r\n */\r\nconst rawButtons = {\r\n  // here is the buttons array that will be dynamically populated:\r\n  \"buttons\": []\r\n}\r\n\r\n// Should not edit\r\nfunction btnFormatter({ id, label, index }) {\r\n  return {\r\n    \"name\": label,\r\n    \"request\": {\r\n      \"type\": \"next\",\r\n      \"payload\": {\r\n        \"btn_index\": index,\r\n        \"btn_id\": id,\r\n        \"label\": label,\r\n        \"actions\": []\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\n// The dynamic array containing button data\r\nconst propertiesArray = propertyNamesArray;\r\n\r\n/**\r\n * Add your dynamic buttons here using a loop\r\n */\r\npropertiesArray.forEach((property, index) => {\r\n  rawButtons.buttons.push(\r\n    btnFormatter({\r\n      id: `btn_id_${index + 1}`, // Generate a unique ID for each button\r\n      index: index,              // Use the current index\r\n      label: property[\"Property Name\"] // Use the \"Property Name\" as the label\r\n    })\r\n  );\r\n});\r\n\r\n/**\r\n * final variable passed to custom action\r\n */\r\nVG_DButtons_Formatted = JSON.stringify(rawButtons);\r\n",
            "paths": [],
            "portsV2": {
              "byKey": {},
              "builtIn": {
                "next": {
                  "type": "next",
                  "target": "67850b159efcbad1ddd9e21b",
