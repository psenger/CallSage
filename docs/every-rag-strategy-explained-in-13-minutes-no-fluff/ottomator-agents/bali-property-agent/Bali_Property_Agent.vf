    },
    {
      "id": "672b421d536596588802db3a",
      "name": "Sell Land",
      "createdByID": 1481114,
      "folderID": null,
      "description": "Trigger this intent when the user explicitly  states that they want to sell a Land. \n\nAnalyze the {vf_memory} to understand if the user wants to sell Land or not.\n\nOnly trigger this intent if the user wants to sell a Land. \n\nDo not assume the needs of the user, unless it is explicitly stated by them.\n\nRemember the difference between \"asking a question\" and \"stating an intent\". If a user says any variation of phrases/sentences like \"I own great Land\", understand that its a statement only, and NOT an intent to sell their Land.\n\nDO NOT trigger this intent, if the user is mentioning a measurement or area size, examples of a measurement and area size are: any variations of - \"100m2\", \"100 m square\", \" 2 acres\", \"2 areas\", \"2 kattah\".\n\nOnly trigger the intent when the user WANTS to sell  a Land. ",
      "automaticReprompt": false,
      "entityOrder": [],
