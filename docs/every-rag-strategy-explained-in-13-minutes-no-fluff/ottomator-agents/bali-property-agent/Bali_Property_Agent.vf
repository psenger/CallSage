        "678f61ebeb1cee0eacde422b": {
          "type": "code",
          "data": {
            "name": "",
            "code": "const newArray = outputArray;\r\n\r\nconst rawCarousel = {\r\n    layout: \"Carousel\",\r\n    cards: newArray.map((item, index) => {\r\n        return {\r\n            id: item.id,\r\n            title: item[\"Property Name\"],\r\n            description: {\r\n                slate: [\r\n                    {\r\n                        children: [\r\n                            {\r\n                                text: `${item.Type} || $${item.Price.toFixed(2)}`,\r\n                            },\r\n                        ],\r\n                    },\r\n                ],\r\n                text: `${item.Type} || $${item.Price.toFixed(2)}`,\r\n            },\r\n            imageUrl: item[\"Property Images\"],\r\n            buttons: [\r\n                {\r\n                    name: \"Schedule a Viewing\",\r\n                    request: {\r\n                        type: \"dcarousel_selection\",\r\n                        payload: {\r\n                            id: item.id,\r\n                            card_index: index,\r\n                            button_index: 0,\r\n                            label: \"Schedule a Viewing\",\r\n                            actions: [],\r\n                            value: item[\"Property Name\"],\r\n                        },\r\n                    },\r\n                },\r\n                {\r\n                    name: \"Browse nearby amenities\",\r\n                    request: {\r\n                        type: \"dcarousel_selection\",\r\n                        payload: {\r\n                            id: item.id,\r\n                            card_index: index,\r\n                            button_index: 1,\r\n                            label: \"Browse nearby amenities\",\r\n                            actions: [],\r\n                            value: item[\"Property Name\"],\r\n                        },\r\n                    },\r\n                },\r\n                {\r\n                    name: \"View Listing\",\r\n                    request: {\r\n                        type: \"dcarousel_selection\",\r\n                        payload: {\r\n                            id: item.id,\r\n                            card_index: index,\r\n                            button_index: 2,\r\n                            label: \"View Listing\",\r\n                            actions: [\r\n                                {\r\n                                    type: \"open_url\",\r\n                                    payload: {\r\n                                        url: item.Link, // Fixed: Correctly references the \"Link\" field\r\n                                    },\r\n                                },\r\n                            ],\r\n                            value: item[\"Property Name\"],\r\n                        },\r\n                    },\r\n                },\r\n            ],\r\n        };\r\n    }),\r\n};\r\nVG_DCarousel_Formatted = JSON.stringify(rawCarousel);\r\nnumber_of_carousels = newArray.length;\r\n",
            "paths": [],
            "portsV2": {
              "byKey": {},
              "builtIn": {
