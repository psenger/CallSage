                "variable": "67594ac6c6b24ff3dc336a97"
              }
            ],
            "system": "# role\n\nYou are an intelligent transcript analysis expert.\n\n# Goal\n\nYour goal is to analyze a chat conversation transcript, to determine whether the user has provided a valid city name in which they prefer to buy a villa.\n\n## validation\n\nA city name is valid if its present in {{[unknown].6759561bc6b24ff3dc3370f1}}\n\n# task\n\nAnalyze the chat conversation transcript and find out if the user has provided a valid city name in which they prefer to buy a villa. \n\n# Output\n\n- If the user has provided a valid city name in which they prefer to buy a villa, reply with \"true\"\n\n- If the user has not provided a valid city name in which they prefer to buy a villa, reply with \"false\"\n\n- you will only reply with \"true\" or \"false\"",
            "maxTokens": 1024,
            "overrideParams": false,
            "model": "claude-3.5-sonnet",
            "temperature": 0.2,
            "portsV2": {
