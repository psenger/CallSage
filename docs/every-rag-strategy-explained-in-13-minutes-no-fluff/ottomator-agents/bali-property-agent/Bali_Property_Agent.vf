        "676031785691bbb194441267": {
          "type": "ai_set",
          "data": {
            "name": "AI Set",
            "label": "Collect_previous_options",
            "sets": [
              {
                "mode": "prompt",
                "prompt": "User query:\n{{[SelectedAmenity].675d842ebdfd5f757ce9be82}}\n\ngiven JSON array:\n{{[collect_options].676031ea1323e693994658c3}}\n\n",
                "variable": "676031ea1323e693994658c3"
              }
            ],
            "system": "You are an expert JSON formatter. \n\nYour job is to add the user query in a given JSON array, to create a new array with the updated values.\n\nExample:\n\nUser query: Beach\n\ngiven JSON array: [\"shopping spots\", \"Gyms\", \"Airport\"]\n\nyour Output:  [\"shopping spots\", \"Gyms\", \"Airport\", \"Beach\"]\n\n# output\n\n- do not explain your output\n- do not wrap your output in any text, not even backticks.\n- Output only the new array. \n\n# notes\n\n- if the given JSON array is empty, just add the user query into th array and output the new array.",
            "maxTokens": 128,
            "overrideParams": false,
            "model": "claude-3.5-sonnet",
            "temperature": 0.2,
            "portsV2": {
              "byKey": {},
              "builtIn": {
                "next": {
                  "type": "next",
                  "target": null,
                  "id": "676031785691bbb194441268"
