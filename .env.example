# =============================================================================
# IVR RAG System Configuration
# =============================================================================
# Copy this file to .env and customize for your environment

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY_REQUIRED=false
# API_KEY=your-secret-api-key-here

# -----------------------------------------------------------------------------
# LLM Configuration (Ollama)
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral
# Alternative models: llama3, phi3, gemma

# Generation parameters
LLM_TEMPERATURE=0.1          # Low = more factual, less creative (0.0-1.0)
LLM_MAX_TOKENS=512           # Maximum response length
LLM_TOP_P=0.9                # Nucleus sampling
LLM_REPEAT_PENALTY=1.1       # Discourage repetition

# -----------------------------------------------------------------------------
# Transcription Configuration (Faster-Whisper)
# -----------------------------------------------------------------------------
WHISPER_MODEL=base.en        # Options: tiny.en, base.en, small.en, medium.en, large-v3
WHISPER_DEVICE=cpu           # Options: cpu, cuda
WHISPER_COMPUTE_TYPE=int8    # Options: int8, float16, float32

# Audio limits
MAX_AUDIO_DURATION=600       # Maximum audio length in seconds (10 min)
MAX_AUDIO_SIZE_MB=25         # Maximum file size

# -----------------------------------------------------------------------------
# RAG Configuration
# -----------------------------------------------------------------------------
# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge_base

# Document chunking
CHUNK_SIZE=500               # Characters per chunk
CHUNK_OVERLAP=50             # Overlap between chunks

# Retrieval
RETRIEVAL_TOP_K=4            # Number of documents to retrieve
RETRIEVAL_FETCH_K=20         # Candidates for MMR
RETRIEVAL_LAMBDA=0.5         # MMR diversity (0=max diversity, 1=max relevance)

# Confidence thresholds
CONFIDENCE_HIGH=0.85         # Answer directly
CONFIDENCE_MEDIUM=0.70       # Answer with caveat
CONFIDENCE_LOW=0.50          # Suggest escalation
# Below LOW = use fallback response

# -----------------------------------------------------------------------------
# Guardrails Configuration
# -----------------------------------------------------------------------------
ENABLE_PII_DETECTION=true
ENABLE_PROFANITY_FILTER=true
ENABLE_INJECTION_DETECTION=true
ENABLE_TOPIC_CLASSIFICATION=true

# Input limits
MAX_INPUT_LENGTH=2000        # Maximum query length in characters

# PII handling
PII_ACTION=redact            # Options: redact, reject, warn

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO               # Options: DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json              # Options: json, text
ENABLE_REQUEST_LOGGING=true

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------
REQUEST_TIMEOUT=30           # Seconds
MAX_CONCURRENT_REQUESTS=10
ENABLE_CACHING=true
CACHE_TTL=3600               # Cache time-to-live in seconds
